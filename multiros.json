{
  "schema": 1,
  "project": "xlerobot",
  "compose": [
    "docker-compose.yml"
  ],
  "backends": {
    "lighter": [
      "docker-compose.lighter.yml"
    ],
    "dri": [
      "docker-compose.dri.yml"
    ],
    "cpu": [
      "docker-compose.cpu.yml"
    ]
  },
  "service": "ros-dev",
  "entrypoint": [
    "/usr/local/bin/xlerobot-entrypoint"
  ],
  "rendering_base": true,
  "submodules": [
    "upstream",
    "dependencies/lekiwi_ros2",
    "dependencies/mod101",
    "tools/multiros"
  ],
  "configuration_env": "XLEROBOT_CONFIGURATION",
  "default_configuration": "standard",
  "configurations": [
    "standard",
    "mod101"
  ],
  "viewer": {
    "runtime": ".runtime",
    "args": [
      "--track-body",
      "chassis",
      "--show-group",
      "2",
      "--hide-group",
      "3",
      "--legacy-snapshots"
    ]
  },
  "container": {
    "image": {
      "default": "xlerobot:jazzy",
      "lighter": "xlerobot:jazzy-lighter"
    },
    "dockerfile": "docker/Dockerfile",
    "workdir": "/workspace/xlerobot",
    "gpu": true,
    "mounts": [
      {
        "source": "{root}",
        "target": "/workspace/xlerobot"
      },
      {
        "type": "volume",
        "source": "xlerobot-build",
        "target": "/workspace/xlerobot/build"
      },
      {
        "type": "volume",
        "source": "xlerobot-install",
        "target": "/workspace/xlerobot/install"
      },
      {
        "type": "volume",
        "source": "xlerobot-log",
        "target": "/workspace/xlerobot/log"
      }
    ],
    "environment": {
      "ROS_DOMAIN_ID": "${XLEROBOT_ROS_DOMAIN_ID:-185}",
      "RMW_IMPLEMENTATION": "rmw_cyclonedds_cpp",
      "MUJOCO_GL": "${XLEROBOT_MUJOCO_GL:-egl}",
      "PYOPENGL_PLATFORM": "${XLEROBOT_MUJOCO_GL:-egl}",
      "EGL_PLATFORM": "surfaceless",
      "GALLIUM_DRIVER": "${XLEROBOT_GALLIUM_DRIVER:-d3d12}",
      "LD_LIBRARY_PATH": "/usr/lib/wsl/lib",
      "XLEROBOT_RENDER_QUALITY": "${XLEROBOT_RENDER_QUALITY:-fast}",
      "XLEROBOT_WORLD_ASSETS": "/workspace/xlerobot/assets/robocasa",
      "PYTHONPATH": "/workspace/xlerobot/src/xlerobot_sim:/opt/xlerobot-python/lib/python3.12/site-packages"
    },
    "backend_environment": {
      "cpu": {
        "MUJOCO_GL": "osmesa",
        "PYOPENGL_PLATFORM": "osmesa",
        "GALLIUM_DRIVER": "llvmpipe"
      }
    },
    "ports": [
      "127.0.0.1:${XLEROBOT_DASHBOARD_PORT:-8889}:8888",
      "127.0.0.1:${XLEROBOT_VIEWER_PORT:-8082}:8080"
    ]
  },
  "workspace": {
    "paths": [
      "src",
      "dependencies/lekiwi_ros2/lekiwi_description",
      "dependencies/lekiwi_ros2/lekiwi_mujoco",
      "dependencies/lekiwi_ros2/lekiwi_control",
      "dependencies/lekiwi_ros2/modules/sts_hardware_interface",
      "dependencies/mod101/src/mod101_description",
      "dependencies/mod101/src/mod101_tool_parallel",
      "dependencies/mod101/src/mod101_tool_pggripper",
      "dependencies/mod101/src/mod101_tool_pincopen",
      "dependencies/mod101/src/mod101_tool_jaws",
      "dependencies/mod101/src/mod101_tool_none",
      "dependencies/mod101/src/mod101_tool_camera"
    ],
    "packages": [
      "lekiwi_description",
      "lekiwi_mujoco",
      "lekiwi_control",
      "sts_hardware_interface",
      "mod101_description",
      "mod101_tool_parallel",
      "mod101_tool_pggripper",
      "mod101_tool_pincopen",
      "mod101_tool_jaws",
      "mod101_tool_none",
      "mod101_tool_camera",
      "robocore_viz",
      "xlerobot_description",
      "xlerobot_control",
      "xlerobot_sim"
    ],
    "workers": 2,
    "cmake_args": [
      "-DPython3_EXECUTABLE=/usr/bin/python3",
      "-DBUILD_TESTING=OFF"
    ]
  },
  "commands": {
    "sim": {
      "where": "container",
      "argv": [
        "bash",
        "scripts/run_sim.sh",
        "{configuration}",
        "headless:=true",
        "mjviser:=false",
        "rviz:=false"
      ]
    },
    "sim-stop": {
      "where": "container",
      "argv": [
        "python3",
        "scripts/stop_sim.py"
      ]
    },
    "dashboard": {
      "where": "container",
      "argv": [
        "python3",
        "-m",
        "xlerobot_sim.dashboard",
        "{configuration}"
      ]
    },
    "world-assets": {
      "where": "container",
      "argv": [
        "python3",
        "tools/prepare_world_assets.py"
      ]
    },
    "test": {
      "where": "container",
      "argv": [
        "python3",
        "checks/check_model.py",
        "--configuration",
        "{configuration}"
      ]
    },
    "check-rendering": {
      "where": "container",
      "argv": [
        "python3",
        "/usr/local/bin/multiros-check-rendering"
      ]
    },
    "check-control": {
      "where": "container",
      "argv": [
        "python3",
        "checks/check_control_stack.py"
      ]
    },
    "check-runtime": {
      "where": "container",
      "argv": [
        "python3",
        "checks/check_runtime.py"
      ]
    },
    "check-dashboard": {
      "where": "container",
      "argv": [
        "python3",
        "checks/check_dashboard.py"
      ]
    },
    "check-tracking": {
      "where": "container",
      "argv": [
        "python3",
        "checks/check_tracking_recovery.py"
      ]
    },
    "check-clearance": {
      "where": "container",
      "argv": [
        "python3",
        "checks/check_tower_clearance.py"
      ]
    },
    "check-nav": {
      "where": "container",
      "argv": [
        "python3",
        "checks/check_navigation.py"
      ]
    },
    "check-unit": {
      "where": "container",
      "argv": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "checks",
        "-p",
        "test_*.py",
        "-v"
      ]
    },
    "teleop": {
      "where": "container",
      "argv": [
        "ros2",
        "run",
        "teleop_twist_keyboard",
        "teleop_twist_keyboard",
        "--ros-args",
        "-p",
        "speed:=0.2",
        "-p",
        "turn:=0.4"
      ],
      "interactive": true
    }
  }
}
