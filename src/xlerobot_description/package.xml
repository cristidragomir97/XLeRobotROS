<?xml version="1.0"?>
<package format="3">
  <name>xlerobot_description</name><version>0.1.0</version>
  <description>ROS kinematic description aligned to the pinned XLeRobot MuJoCo model.</description>
  <maintainer email="dev@robocore.ai">Robocore</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>robot_state_publisher</exec_depend><exec_depend>xacro</exec_depend>
  <exec_depend>mod101_description</exec_depend>
  <!-- The upstream reusable macro includes every tool xacro at load time. -->
  <exec_depend>mod101_tool_parallel</exec_depend>
  <exec_depend>mod101_tool_pggripper</exec_depend>
  <exec_depend>mod101_tool_pincopen</exec_depend>
  <exec_depend>mod101_tool_jaws</exec_depend>
  <exec_depend>mod101_tool_none</exec_depend>
  <exec_depend>mod101_tool_camera</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
