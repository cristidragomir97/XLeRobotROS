# ROS graph inside the runtime.
XLEROBOT_ROS_DOMAIN_ID=185

# Host port mappings for the container-served services.
XLEROBOT_DASHBOARD_PORT=8889

# The lighter default is EGL/Zink GPU rendering using the patched multiROS base.
# Optional CPU fallback: set both values and recreate the container.
# XLEROBOT_MUJOCO_GL=osmesa
# XLEROBOT_GALLIUM_DRIVER=llvmpipe
# Sensor quality: fast (no MSAA/shadows/reflections), or standard.
# XLEROBOT_RENDER_QUALITY=standard

# Runtime/backend can also be selected with MULTIROS_RUNTIME and MULTIROS_BACKEND.

# Default arm configuration: standard or mod101.
XLEROBOT_CONFIGURATION=standard

# Original visual meshes for comparison (default: simplified).
# XLEROBOT_VISUAL_MESHES=full
